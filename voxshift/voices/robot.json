        "rate_hz": 0.3,
        "voices": 1,
        "mix": 0.5
      }
    },
    {
      "type": "Compressor",
      "params": {
        "threshold_db": -24,
        "ratio": 4,
        "makeup_db": 6
      }
    }
  ]
}
